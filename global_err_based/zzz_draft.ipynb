    "from sympy import *"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "05818ec4",
   "metadata": {},
   "outputs": [],
   "source": [
    "x, y = symbols('x y')\n",
    "\n",
    "u = exp(x**2 + y**2) - 3\n",
    "v = x + y - sin(3 * (x+y))\n",
    "\n",
    "for func in [u, v]:\n",
    "    for arg in [x, y]:\n",
    "        print(func.diff(arg))\n"
   ]
